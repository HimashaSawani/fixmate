# FixMate Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Security & Rate Limiting
API_KEY=fixmate_secret_dev_key
RATE_LIMIT_PER_MINUTE=60
MAX_IMAGE_SIZE_MB=10

# OCR Engine Choice: auto, easyocr, tesseract
OCR_ENGINE=auto

# Step 5: LLM Configuration (for future agent queries)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
